<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_status"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_status_short"
        android:shortcutLongLabel="@string/shortcut_status_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="net.igng.mcstatus"
            android:targetClass="net.igng.mcstatus.MainActivity">
            <extra android:name="igng_shortcut_action" android:value="status" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_map"
        android:enabled="true"
