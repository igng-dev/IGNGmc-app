#!/usr/bin/env bash
# 设备级 pre-push 守卫（版本化副本，同步自 ~/.qoder/coder-rules/hooks/pre-push.tpl）
#
# pre-push 的 stdin 每行有 4 个字段：
#   <local-ref> SP <local-oid> SP <remote-ref> SP <remote-oid>
# 删除分支时 local-oid 全 0；远端新建分支时 remote-oid 全 0。
set -uo pipefail

MODE="collaborative"      # solo | collaborative | frozen
PROTECT="main master"     # 受保护分支（空格分隔）
ZEROS=0000000000000000000000000000000000000000
blocked=0

data=$(cat)

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_ref:-}" ] || continue
  name=${remote_ref#refs/heads/}
  [ -n "$name" ] || name=${local_ref#refs/heads/}

  # _anchor 是主目录空树分支，只存在于本机，永远不推送
  if [ "$name" = "_anchor" ]; then
    echo "pre-push 拒绝：_anchor 是主目录空树分支，只存本机，不推送。" >&2
    blocked=1
    continue
  fi

  is_protected=0
  case " $PROTECT " in *" $name "*) is_protected=1 ;; esac

  # 删除远端分支
  if [ "$local_oid" = "$ZEROS" ]; then
    if [ "$is_protected" = 1 ]; then
      echo "pre-push 拒绝：不允许删除远端分支 $name（需明确确认）。" >&2
      blocked=1
    fi
    continue
  fi

  # 新建远端分支：remote_oid 全 0，无需快进检查
  if [ "$remote_oid" = "$ZEROS" ]; then
    if [ "$is_protected" = 1 ]; then
      echo "pre-push 拒绝：$name 是集成分支，不允许直接新建（改动走 Pull Request）。" >&2
      blocked=1
    fi
    continue
  fi

  # 非快进（需要 force）：集成分支禁止重写历史；
  # Agent 独占分支按设备级规范允许 --force-with-lease（钩子看不到具体 flag，故不拦）。
  if [ "$is_protected" = 1 ] && ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    echo "pre-push 拒绝：$name 是受保护分支且非快进。集成分支不允许重写历史。" >&2
    blocked=1
  fi

  # 统一 PR：任何模式都禁止直推集成分支。solo 只是免人工 review，不是免 PR。
  # 确需绕过（用户明确授权的热修复或历史修复）：GIT_ALLOW_DIRECT_PUSH=1，并在回报中写明绕过了什么。
  if [ "$is_protected" = 1 ] && [ "${GIT_ALLOW_DIRECT_PUSH:-}" != "1" ]; then
    echo "pre-push 拒绝：$name 是集成分支，规定改动一律经 Pull Request 进入。" >&2
    echo "  请 push 任务分支后 gh pr create；用户明确授权直推时用 GIT_ALLOW_DIRECT_PUSH=1 git push ..." >&2
    blocked=1
  fi

  if [ "$MODE" = frozen ]; then
    echo "pre-push 拒绝：本仓库标记为 frozen，不接收推送。" >&2
    blocked=1
  fi
done <<< "$data"

common_dir=$(git rev-parse --git-common-dir 2>/dev/null || printf '%s' "${GIT_DIR:-.git}")
orig="${common_dir}/hooks/pre-push.orig"
if [ -x "$orig" ]; then
  if ! printf '%s\n' "$data" | "$orig" "$@"; then
    echo "pre-push 拒绝：仓库原有的 pre-push 钩子返回失败。" >&2
    blocked=1
  fi
fi

exit $blocked
