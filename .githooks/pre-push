#!/usr/bin/env sh
# 设备级 pre-push 守卫（版本化副本，因本仓库使用 core.hooksPath=.githooks）
# 规则来源：~/.qoder/coder-rules/global-rules.md 第 5/7 节 —— 本仓库 Collaboration: collaborative
set -u
PROTECTED="main master"
ZEROS=0000000000000000000000000000000000000000
blocked=0
while read -r ref local remote; do
  [ -n "$ref" ] || continue
  name=${ref#refs/heads/}
  case " $PROTECTED " in *" $name "*)
    if [ "$local" = "$ZEROS" ]; then
      echo "pre-push 拒绝：不允许删除远端 $name。" >&2; blocked=1
    elif [ "$remote" != "$ZEROS" ] && ! git merge-base --is-ancestor "$remote" "$local" 2>/dev/null; then
      echo "pre-push 拒绝：$name 非快进，需要 --force。$name 是集成分支，不允许。" >&2; blocked=1
    else
      echo "pre-push 拒绝：$name 是集成分支，改动必须走 Pull Request（GitHub 已启用分支保护：禁 force push、禁删除）。" >&2; blocked=1
    fi ;;
  esac
done
exit $blocked
